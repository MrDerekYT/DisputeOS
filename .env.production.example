# Production. Set in the host's secret manager. Never commit a filled-in copy. Back up PII_ENCRYPTION_KEY separately:
# without it, encrypted client identifiers and stored documents cannot be recovered.
APP_ENV=production
APP_URL=https://app.your-domain.example
DATABASE_URL=postgres://app_user:CHANGE_ME@prod-db.example:5432/disputeos?sslmode=require
PII_ENCRYPTION_KEY=            # openssl rand -base64 32
PII_ENCRYPTION_KEY_ID=1
REQUIRE_STAFF_MFA=true
STAFF_IDLE_MINUTES=60
STORAGE_DIR=/var/lib/disputeos/vault
EMAIL_DRIVER=resend
EMAIL_FROM="Your Business <no-reply@your-domain.example>"
RESEND_API_KEY=
AI_PROVIDER=rules              # or anthropic / openai with credentials
CRON_SECRET=                   # openssl rand -hex 24
