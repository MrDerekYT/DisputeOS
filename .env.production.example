# Production. Set in the host's secret manager. Never commit a filled-in copy. Back up PII_ENCRYPTION_KEY separately:
# without it, encrypted client identifiers and stored documents cannot be recovered.
APP_ENV=production
APP_URL=https://app.your-domain.example
DATABASE_URL=postgres://app_user:CHANGE_ME@prod-db.example:5432/disputeos   # TLS with certificate verification is automatic for a remote host
DATABASE_CA_CERT=              # PEM of the database's CA, if it is not a public one (Supabase: see docs/DEPLOY-VERCEL.md)
PII_ENCRYPTION_KEY=            # openssl rand -base64 32
PII_ENCRYPTION_KEY_ID=1
REQUIRE_STAFF_MFA=true
TRUSTED_PROXY_HOPS=1            # reverse proxies in front of the app; see docs/SECURITY_AND_COMPLIANCE.md
APP_TIMEZONE=America/New_York   # your business timezone (IANA name)
STAFF_IDLE_MINUTES=60
STORAGE_DRIVER=disk            # or db on hosts with no persistent disk (required on Vercel)
STORAGE_DIR=/var/lib/disputeos/vault
EMAIL_DRIVER=resend            # or disabled to run without email (no password-reset emails); log is refused
EMAIL_FROM="Your Business <no-reply@your-domain.example>"
RESEND_API_KEY=
AI_PROVIDER=rules              # or anthropic / openai with credentials
CRON_SECRET=                   # openssl rand -hex 24  (npm run secrets:gen prints this and the encryption key)
