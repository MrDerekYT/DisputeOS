# DisputeOS environment reference. Copy to .env.local (development) and NEVER commit real values.
# staging / production: set these in your host's secret manager, not in files. See docs/ENVIRONMENTS.md.

# development | test | staging | production   (defaults from NODE_ENV when unset)
APP_ENV=development
APP_URL=http://localhost:3000

# --- Database (PostgreSQL 14+; Supabase, Neon, RDS, or local) ---------------------------------------------------
# The role in this URL owns the tables and must be able to `SET ROLE disputeos_rls` (migration 0001 creates it;
# it needs CREATEROLE once, or ask your DBA to run: create role disputeos_rls nologin noinherit;
#                                                  grant disputeos_rls to <your_app_role>;)
DATABASE_URL=postgres://user:password@localhost:5432/disputeos_dev
# Used instead of DATABASE_URL when APP_ENV=test
DATABASE_URL_TEST=postgres://user:password@localhost:5432/disputeos_test
# A database on another machine is always reached over TLS with the certificate verified. If its certificate is signed
# by a private CA (Supabase: Database Settings → SSL Configuration), paste that CA's PEM text here. A database on a
# private network without TLS needs ?sslmode=disable in the URL. See scripts/pg-config.mjs.
DATABASE_CA_CERT=
# Connections one server process may hold. Default 10 (3 on Vercel).
DB_POOL_MAX=

# --- Encryption (REQUIRED in staging/production) ------------------------------------------------------------------
# Blank values are treated as "not set" (development then uses a throwaway key).
# openssl rand -base64 32      Rotating: set the NEW key + a new _ID, move the old key to _PREVIOUS (+ _PREVIOUS_ID).
PII_ENCRYPTION_KEY=
PII_ENCRYPTION_KEY_ID=1
PII_ENCRYPTION_KEY_PREVIOUS=
PII_ENCRYPTION_KEY_PREVIOUS_ID=

# --- Security -----------------------------------------------------------------------------------------------------
REQUIRE_STAFF_MFA=false         # optional two-step verification; set true to make it mandatory for staff
STAFF_IDLE_MINUTES=120
# Reverse proxies in front of the app (1 = one proxy / load balancer). Rate limits and the audit log use the
# x-forwarded-for entry written by that proxy, never the value a browser sends. See docs/SECURITY_AND_COMPLIANCE.md.
TRUSTED_PROXY_HOPS=1
# Timezone your business works in: decides what "today" is when a sent-on date is left blank.
APP_TIMEZONE=America/New_York

# --- Storage (encrypted documents) ------------------------------------------------------------------------------
STORAGE_DRIVER=disk             # disk (files under STORAGE_DIR) | db (rows in the database; for hosts with no persistent disk, e.g. Vercel)
STORAGE_DIR=.storage            # disk driver: use a persistent, access-controlled volume in production
# Largest upload in MB (1-10). Default 10; 4 on Vercel, which refuses request bodies over 4.5 MB.
MAX_UPLOAD_MB=

# --- Email --------------------------------------------------------------------------------------------------------
EMAIL_DRIVER=log                # log (nothing is sent; development/test only) | resend | disabled (no email provider: nothing is sent and the app says so)
EMAIL_FROM="DisputeOS <no-reply@yourdomain.com>"
RESEND_API_KEY=
# Partner emails (optional, recommended): their own sending address on a separate subdomain, with its own Resend key,
# so cold business email cannot hurt the address that carries password resets and client updates.
OUTREACH_EMAIL_FROM=
OUTREACH_RESEND_API_KEY=
# Signing secret of the Resend webhook (whsec_...) that reports bounces and spam complaints to /api/webhooks/resend.
RESEND_WEBHOOK_SECRET=
# Deployment-wide limits per 24 hours, across all workspaces (defaults: 500 partner emails, 300 lead texts).
OUTREACH_PLATFORM_DAILY_EMAILS=
OUTREACH_PLATFORM_DAILY_TEXTS=

# --- Text messages (client updates, lead follow-up texts, the setup test text; optional) ---------------------------
# disabled (default: no text is ever sent) | twilio | log (written to a local file, nothing is sent; development/test only)
SMS_DRIVER=disabled
# With SMS_DRIVER=twilio: the Account SID and Auth Token from the Twilio Console, and EITHER a Messaging Service SID
# (MG…, recommended) OR one sending number in E.164 form (+15551234567). Setup steps: docs/INTEGRATIONS.md.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_FROM_NUMBER=

# --- AI assistant (optional; the rules engine works with none of these) -------------------------------------------
# anthropic: Claude through the official SDK. Built to the current API; proven live only once `npm run ai:prove` has
# passed with a real key (docs/INTEGRATIONS.md, "AI provider (Claude)"). Then press "Test the AI connection" on the
# Get set up page, and grant AI credits (every workspace starts at 0).
AI_PROVIDER=rules               # rules | anthropic | openai (any OpenAI-compatible endpoint)
# The secret key from the Anthropic Console. On a host, mark it as a secret / Sensitive variable.
ANTHROPIC_API_KEY=
# Default claude-opus-5-5 ($4 / $20 per million input / output tokens). Cheaper: claude-sonnet-5-5 ($2 / $10) or
# claude-haiku-5-5 ($0.10 / $0.50). Write the id exactly so, with no date suffix. Required with openai.
AI_MODEL=
# low (default) | medium | high: how hard Claude thinks before it answers. Higher costs more and takes longer.
AI_EFFORT=
# Only with AI_PROVIDER=openai.
AI_BASE_URL=
AI_API_KEY=

# --- Billing ------------------------------------------------------------------------------------------------------
# Payments are recorded manually; there is no card-processor integration and no variable to set (docs/INTEGRATIONS.md).

# --- Custom domains for agency websites (optional; docs/DEPLOY-VERCEL.md). Without these, a domain an agency connects
#     stays pending until you add it at the hosting provider and run: npm run domain:verify -- <domain>
#     (that command also needs PII_ENCRYPTION_KEY: it checks the workspace's own TXT record in the domain's DNS)
VERCEL_API_TOKEN=
VERCEL_PROJECT_ID=
VERCEL_TEAM_ID=

# --- Scheduled jobs: POST (or GET, for Vercel Cron) /api/jobs/run with header "authorization: Bearer <CRON_SECRET>" (min 24 chars) -----------
CRON_SECRET=
# `npm run jobs:run` makes that same call against APP_URL (or JOBS_URL if set) and exits non-zero on failure.
# JOBS_URL=http://localhost:3000
