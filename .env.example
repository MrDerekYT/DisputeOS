NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=
# 32-byte key, base64. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
FIELD_ENCRYPTION_KEY=
SENTRY_DSN=
# Signs client invite links. Required in production.
INVITE_SECRET=
# Local demos only: accept intake submissions without storing them.
INTAKE_PREVIEW=

# Public production URL, used for canonical links, sitemap and JSON-LD (required in production)
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Staff preview login (leave unset to use Supabase auth + MFA)
ADMIN_EMAIL=
ADMIN_PASSWORD=
SESSION_SECRET=
# Optional LLM polish for client updates (OpenAI-compatible)
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
