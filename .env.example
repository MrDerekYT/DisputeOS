# Supabase (https://supabase.com/dashboard -> Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server-only. NEVER expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Field-level encryption key (32 bytes, base64). Generate: openssl rand -base64 32
PII_ENCRYPTION_KEY=

# Later phases (placeholders)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
RESEND_API_KEY=
MAIL_PROVIDER=lob # lob | postgrid | click2mail | manual
LOB_API_KEY=
POSTGRID_API_KEY=
CLICK2MAIL_USERNAME=
CLICK2MAIL_PASSWORD=

# Observability (leave SENTRY_DSN empty to disable). PII is scrubbed before send.
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
# Key rotation: set *_PREVIOUS(_ID) to the old key while re-encrypting, then remove.
PII_ENCRYPTION_KEY_ID=1
PII_ENCRYPTION_KEY_PREVIOUS=
PII_ENCRYPTION_KEY_PREVIOUS_ID=
