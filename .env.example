# DisputeOS environment reference. Copy to .env.local (development) and NEVER commit real values.
# staging / production: set these in your host's secret manager, not in files. See docs/ENVIRONMENTS.md.

# development | test | staging | production   (defaults from NODE_ENV when unset)
APP_ENV=development
APP_URL=http://localhost:3000

# --- Database (PostgreSQL 14+; Supabase, Neon, RDS, or local) ---------------------------------------------------
# The role in this URL owns the tables and must be able to `SET ROLE disputeos_rls` (migration 0001 creates it;
# it needs CREATEROLE once, or ask your DBA to run: create role disputeos_rls nologin noinherit;
#                                                  grant disputeos_rls to <your_app_role>;)
DATABASE_URL=postgres://user:password@localhost:5432/disputeos_dev
# Used instead of DATABASE_URL when APP_ENV=test
DATABASE_URL_TEST=postgres://user:password@localhost:5432/disputeos_test

# --- Encryption (REQUIRED in staging/production) ------------------------------------------------------------------
# openssl rand -base64 32      Rotating: set the NEW key + a new _ID, move the old key to _PREVIOUS (+ _PREVIOUS_ID).
PII_ENCRYPTION_KEY=
PII_ENCRYPTION_KEY_ID=1
PII_ENCRYPTION_KEY_PREVIOUS=
PII_ENCRYPTION_KEY_PREVIOUS_ID=

# --- Security -----------------------------------------------------------------------------------------------------
REQUIRE_STAFF_MFA=true          # must stay true in staging/production
STAFF_IDLE_MINUTES=120

# --- Storage (encrypted documents) ------------------------------------------------------------------------------
STORAGE_DIR=.storage            # use a persistent, access-controlled volume in production

# --- Email --------------------------------------------------------------------------------------------------------
EMAIL_DRIVER=log                # log (nothing is sent) | resend
EMAIL_FROM="DisputeOS <no-reply@yourdomain.com>"
RESEND_API_KEY=

# --- AI assistant (optional; the rules engine works with none of these) -------------------------------------------
AI_PROVIDER=rules               # rules | anthropic | openai (any OpenAI-compatible endpoint)
AI_MODEL=
ANTHROPIC_API_KEY=
AI_BASE_URL=
AI_API_KEY=

# --- Billing (optional) -------------------------------------------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Scheduled jobs: POST /api/jobs/run with header "authorization: Bearer <CRON_SECRET>" (min 24 chars) -----------
CRON_SECRET=
# `npm run jobs:run` makes that same call against APP_URL (or JOBS_URL if set) and exits non-zero on failure.
# JOBS_URL=http://localhost:3000
