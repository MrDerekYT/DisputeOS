# Staging: a production-like rehearsal. Set these in your host's secret manager — do not commit a filled-in copy.
APP_ENV=staging
APP_URL=https://staging.your-domain.example
DATABASE_URL=postgres://app_user:CHANGE_ME@staging-db.example:5432/disputeos?sslmode=require
PII_ENCRYPTION_KEY=            # openssl rand -base64 32   (different from production!)
PII_ENCRYPTION_KEY_ID=1
REQUIRE_STAFF_MFA=true
STORAGE_DIR=/var/lib/disputeos/vault
EMAIL_DRIVER=resend
EMAIL_FROM="DisputeOS Staging <no-reply@staging.your-domain.example>"
RESEND_API_KEY=
AI_PROVIDER=rules
CRON_SECRET=                   # openssl rand -hex 24
